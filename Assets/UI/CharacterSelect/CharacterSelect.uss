:root {
}

.characterPreview {
    width: 150px;
    height: 150px;
    background-color: rgb(203, 203, 203);
    justify-content: center;
    align-items: center;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.playerConfirmed {
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(0, 255, 93);
    border-right-color: rgb(0, 255, 93);
    border-top-color: rgb(0, 255, 93);
    border-bottom-color: rgb(0, 255, 93);
}

.colorTakenWarning {
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(255, 0, 0);
    -unity-text-align: middle-center;
    background-color: rgb(151, 220, 137);
    border-left-color: rgb(254, 254, 254);
    border-right-color: rgb(254, 254, 254);
    border-top-color: rgb(254, 254, 254);
    border-bottom-color: rgb(254, 254, 254);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
    -unity-text-outline-width: 1px;
    text-shadow: 2px -1px 0 rgba(0, 0, 0, 0.98);
    padding-top: 12px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-text-outline-color: rgb(205, 0, 0);
    letter-spacing: 4px;
}
